<UserControl x:Class="PowerAim.UILibrary.GildeConnectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignWidth="560">
    <Grid>
        <!-- Starts at 0 height and grows to whatever the widget reports, so an unreachable
             connect.gilde.org leaves no empty box behind in the About page. -->
        <wv2:WebView2 x:Name="Web" Height="0" DefaultBackgroundColor="Transparent" />

        <!-- Shown instead of the widget when WebView2 can't run (runtime missing, no network). -->
        <TextBlock x:Name="Fallback"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   FontFamily="Segoe UI Variable Text"
                   FontSize="12"
                   Foreground="{DynamicResource FluentTextSecondary}">
            <Hyperlink x:Name="FallbackLink"
                       Foreground="{DynamicResource FluentAccent}"
                       RequestNavigate="FallbackLink_RequestNavigate">
                <Run x:Name="FallbackRun" />
            </Hyperlink>
        </TextBlock>
    </Grid>
</UserControl>
