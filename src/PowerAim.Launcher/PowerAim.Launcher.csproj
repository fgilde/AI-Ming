<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>PowerAim.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Shipped and started as Launcher.exe (UpdateManager restarts it by that name). -->
    <AssemblyName>Launcher</AssemblyName>
    <!-- Next to the app's output so a local Debug launcher finds the app, as before the src/ move. -->
    <BaseOutputPath>../PowerAim.App/bin/</BaseOutputPath>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="PowerAim.ico" />
    <None Remove="PowerAim.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vestris.ResourceLib" Version="2.2.0" />
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="PowerAim.ico" />
    <Resource Include="PowerAim.png" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerAim.Core\PowerAim.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>