<Window x:Class="PowerAim.UI.Visuality.DebugLogPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerAim — Debug &amp; Health"
        Width="1100" Height="640"
        MinWidth="800" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        FontSize="12">
    <DockPanel Margin="10">
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <ToggleButton x:Name="BtnEnabled" Content="Logging OFF" Margin="0,0,8,0" Padding="12,5"
                          Click="BtnEnabled_Click"/>
            <Button Content="Refresh Health" Margin="0,0,8,0" Padding="12,5" Click="BtnHealth_Click"/>
            <Button Content="Clear Log" Margin="0,0,8,0" Padding="12,5" Click="BtnClear_Click"/>
            <Button Content="Copy Visible" Margin="0,0,8,0" Padding="12,5" Click="BtnCopy_Click"/>
            <Button Content="Export Health" Margin="0,0,8,0" Padding="12,5" Click="BtnExportHealth_Click"/>
            <Button Content="Open Log Folder" Margin="0,0,8,0" Padding="12,5" Click="BtnFolder_Click"/>
            <Button Content="Flush" Margin="0,0,8,0" Padding="12,5" Click="BtnFlush_Click"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                       Opacity="0.75" TextWrapping="NoWrap"/>
        </StackPanel>

        <!-- Filter row -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FilterBox" Width="220" Padding="4,3" Margin="0,0,12,0"
                     Background="#2A2A2A" Foreground="#EEE" BorderBrush="#444"
                     TextChanged="FilterBox_TextChanged"/>
            <CheckBox x:Name="ChkErrorsOnly" Content="Errors/Warn only" VerticalAlignment="Center"
                      Margin="0,0,12,0" Foreground="#EEE" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True"
                      VerticalAlignment="Center" Foreground="#EEE"/>
            <TextBlock x:Name="TxtCounts" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.7"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Background="#1A1A1A" BorderBrush="#333">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#CCC"/>
                    <Setter Property="Background" Value="#2A2A2A"/>
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
            </TabControl.Resources>

            <!-- Live log -->
            <TabItem Header="Event Log">
                <TextBox x:Name="LogView"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         Background="#111"
                         Foreground="#C8C8C8"
                         BorderBrush="#333"
                         FontFamily="Consolas"
                         FontSize="11"
                         Padding="6"/>
            </TabItem>

            <!-- System health -->
            <TabItem Header="System Health">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HealthSummary" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <DataGrid x:Name="HealthGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="#111"
                              Foreground="#DDD"
                              BorderBrush="#333"
                              RowBackground="#181818"
                              AlternatingRowBackground="#1E1E1E"
                              HorizontalGridLinesBrush="#2A2A2A"
                              FontFamily="Consolas"
                              FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                            <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="90"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Feature map (toggles only, compact) -->
            <TabItem Header="Features">
                <TextBox x:Name="FeaturesView"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         Background="#111"
                         Foreground="#C8C8C8"
                         BorderBrush="#333"
                         FontFamily="Consolas"
                         FontSize="11"
                         Padding="6"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
