<Window x:Class="PowerAim.UI.Visuality.FOV"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PowerAim.UI.Visuality"
        mc:Ignorable="d"
        Title="FOV"
        Background="Transparent"
        Foreground="{x:Null}"
        Topmost="True"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        IsVisibleChanged="OnIsVisibleChanged"
        Visibility="Visible"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        SizeChanged="OnWindowSizeChanged"
        LocationChanged="OnWindowLocationChanged">

    <!-- FOV guide only. Capture region remains a square of ActualFovSize; the ring is visual. -->
    <Grid Visibility="{Binding Path=ToggleState.FOV, Converter={StaticResource boolToVis}}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          MouseMove="OnMouseMove">
        <Grid x:Name="FOVStrictEnclosure"
              Visibility="{Binding Path=ToggleState.GlobalActive, Converter={StaticResource boolToVis}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- Layered ring: soft outer glow + crisp stroke + light dash + center cross -->
            <Canvas x:Name="FovCanvas"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="{Binding SliderSettings.ActualFovSize}"
                    Height="{Binding SliderSettings.ActualFovSize}"
                    IsHitTestVisible="False">

                <!-- Soft outer glow -->
                <Ellipse x:Name="Glow"
                         Width="{Binding SliderSettings.ActualFovSize}"
                         Height="{Binding SliderSettings.ActualFovSize}"
                         StrokeThickness="5"
                         Opacity="0.28"
                         IsHitTestVisible="False">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{Binding ColorState.FOVColor}" />
                    </Ellipse.Stroke>
                </Ellipse>

                <!-- Main crisp ring -->
                <Ellipse x:Name="Circle"
                         Width="{Binding SliderSettings.ActualFovSize}"
                         Height="{Binding SliderSettings.ActualFovSize}"
                         StrokeThickness="1.75"
                         IsHitTestVisible="False">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{Binding ColorState.FOVColor}" />
                    </Ellipse.Stroke>
                </Ellipse>

                <!-- Subtle dashed inner ring (reads better on busy scenes) -->
                <Ellipse x:Name="DashRing"
                         Width="{Binding SliderSettings.ActualFovSize}"
                         Height="{Binding SliderSettings.ActualFovSize}"
                         StrokeThickness="1"
                         StrokeDashArray="3 5"
                         Opacity="0.55"
                         IsHitTestVisible="False">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{Binding ColorState.FOVColor}" />
                    </Ellipse.Stroke>
                </Ellipse>

                <!-- Center cross (short ticks) — not full crosshair clutter -->
                <Line x:Name="CrossH"
                      StrokeThickness="1.25"
                      Opacity="0.85"
                      IsHitTestVisible="False"
                      X1="0" Y1="0" X2="0" Y2="0">
                    <Line.Stroke>
                        <SolidColorBrush Color="{Binding ColorState.FOVColor}" />
                    </Line.Stroke>
                </Line>
                <Line x:Name="CrossV"
                      StrokeThickness="1.25"
                      Opacity="0.85"
                      IsHitTestVisible="False"
                      X1="0" Y1="0" X2="0" Y2="0">
                    <Line.Stroke>
                        <SolidColorBrush Color="{Binding ColorState.FOVColor}" />
                    </Line.Stroke>
                </Line>
            </Canvas>
        </Grid>
    </Grid>
</Window>