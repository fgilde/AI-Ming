<UserControl x:Class="PowerAim.UI.UILibrary.DecisionModelList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600">
    <!-- The decision models AutoPlay profiles can pick. Each row edits one entry in place; built-ins
         can be tuned but not deleted. "Test" checks reachability (or, for the learned model, data). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ItemsControl x:Name="ModelsList" ItemsSource="{Binding Models}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource FluentStroke}" BorderThickness="0,0,0,1" Padding="2,6,2,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="1" BorderBrush="{DynamicResource FluentStroke}"
                                         Padding="3,4,1,4" FontFamily="Segoe UI Variable Text"
                                         Foreground="{DynamicResource FluentTextPrimary}" Background="Transparent" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding DataContext.Kinds, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Kind, Mode=TwoWay}"
                                              Padding="3,4,1,4" FontFamily="Segoe UI Variable Text"
                                              Foreground="{DynamicResource FluentTextPrimary}" />
                                    <TextBox Grid.Column="1" Margin="6,0,0,0"
                                             Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding UsesModelName}"
                                             ToolTip="{Binding Converter={StaticResource localeConverter}, ConverterParameter='DecisionModelModelTooltip'}"
                                             BorderThickness="1" BorderBrush="{DynamicResource FluentStroke}"
                                             Padding="3,4,1,4" FontFamily="Segoe UI Variable Text"
                                             Foreground="{DynamicResource FluentTextPrimary}" Background="Transparent" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox IsChecked="{Binding AskPerAction, Mode=TwoWay}"
                                              IsEnabled="{Binding SupportsPerAction}"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource FluentTextPrimary}"
                                              ToolTip="{Binding Converter={StaticResource localeConverter}, ConverterParameter='DecisionModelPerActionTooltip'}"
                                              Content="{Binding Converter={StaticResource localeConverter}, ConverterParameter='DecisionModelPerAction'}" />
                                    <TextBlock Margin="14,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FluentTextSecondary}"
                                               Text="{Binding Converter={StaticResource localeConverter}, ConverterParameter='DecisionModelThreshold'}" />
                                    <Slider Width="120" Minimum="0.05" Maximum="0.95" SmallChange="0.05" LargeChange="0.1"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            IsEnabled="{Binding UsesThreshold}"
                                            ToolTip="{Binding Converter={StaticResource localeConverter}, ConverterParameter='DecisionModelThresholdTooltip'}"
                                            Value="{Binding ActionThreshold, Mode=TwoWay}" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FluentTextSecondary}"
                                               Text="{Binding ActionThreshold, StringFormat={}{0:0.00}}" />
                                </StackPanel>
                                <TextBlock Margin="2,4,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource FluentTextSecondary}"
                                           Tag="{Binding}" Loaded="StatusText_Loaded" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource FluentIconButton}" Tag="{Binding}" Click="Test_Click"
                                        ToolTip="{Binding Converter={StaticResource localeConverter}, ConverterParameter='DecisionModelTest'}"
                                        Foreground="{DynamicResource FluentTextPrimary}" Content="&#xE9D9;" FontSize="18" Width="44" />
                                <Button Style="{StaticResource FluentIconButton}" Tag="{Binding}" Click="Delete_Click"
                                        IsEnabled="{Binding CanDelete}"
                                        ToolTip="{Binding Converter={StaticResource localeConverter}, ConverterParameter='Delete'}"
                                        Foreground="{DynamicResource FluentTextPrimary}" Content="&#xE74D;" FontSize="18" Width="44" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Grid.Row="1" Style="{StaticResource FluentIconButton}" HorizontalAlignment="Right"
                ToolTip="{Binding Converter={StaticResource localeConverter}, ConverterParameter='AddDecisionModel'}"
                Click="Add_Click" Foreground="{DynamicResource FluentTextPrimary}" Content="&#xECC8;" FontSize="20" Width="50" />
    </Grid>
</UserControl>
