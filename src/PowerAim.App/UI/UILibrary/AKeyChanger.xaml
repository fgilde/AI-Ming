<UserControl x:Class="PowerAim.UI.UILibrary.AKeyChanger"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Nextended.UI.WPF.Controls;assembly=Nextended.UI"
             x:Name="Root"
             Loaded="AKeyChanger_OnLoaded"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             d:DesignHeight="40">
    <!-- App policy (persistence, Global-Active gate, localization, theme) around the generic Nextended control. -->
    <controls:KeyBindChanger x:Name="Changer"
                             KeyBind="{Binding KeyBind, ElementName=Root, Mode=TwoWay}"
                             BindingManager="{Binding BindingManager, ElementName=Root}"
                             FontFamily="Segoe UI Variable Text"
                             Foreground="{DynamicResource FluentTextPrimary}"
                             ButtonBackground="{DynamicResource FluentSurface3}"
                             ButtonBorderBrush="{DynamicResource FluentStroke}"
                             PopupBackground="{DynamicResource FluentSurface2}" />
</UserControl>
